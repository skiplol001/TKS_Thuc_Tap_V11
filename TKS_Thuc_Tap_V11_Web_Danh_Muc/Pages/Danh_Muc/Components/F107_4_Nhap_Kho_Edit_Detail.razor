@inherits FBase;

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; padding-left: 0px; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">@Get_Language_Data_Field("Hiệu chỉnh chi tiết phiếu nhập")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="@(() => Modal_Cancel())">
                </button>
            </div>

            @((MarkupString)r_strError)

            <div class="modal-body">
                @* ===== THÔNG TIN PHIẾU (LABEL ONLY) ===== *@
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">@Get_Language_Data_Field("Thông tin phiếu nhập")</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-3">
                                <label class="form-label">@Get_Language_Data_Field("Số phiếu:"):</label>
                                <p><strong>@(m_objMaster?.So_Phieu_Nhap_Kho ?? "")</strong></p>
                            </div>
                            <div class="col-lg-3">
                                <label class="form-label">@Get_Language_Data_Field("Kho"):</label>
                                <p><strong>@(m_objMaster?.Ten_Kho ?? "")</strong></p>
                            </div>
                            <div class="col-lg-3">
                                <label class="form-label">@Get_Language_Data_Field("Ngày nhập"):</label>
                                <p>@(m_objMaster?.Ngay_Nhap_Kho?.ToString("dd/MM/yyyy") ?? "")</p>
                            </div>
                            <div class="col-lg-3">
                                <label class="form-label">@Get_Language_Data_Field("Ghi chú"):</label>
                                <p>@(m_objMaster?.Ghi_Chu ?? "")</p>
                            </div>
                        </div>
                    </div>
                </div>

                @* ===== NÚT THÊM DÒNG ===== *@
                <div class="row mb-2">
                    <div class="col-lg-12 text-end">
                        <button type="button" class="btn btn-sm btn-success" @onclick="Mo_Form_Them">
                            <i class="mdi mdi-plus"></i> @Get_Language_Data_Field("Thêm dòng")
                        </button>
                    </div>
                </div>

                @* ===== GRID DETAIL ===== *@
                <div style="max-height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px;">
                    <table class="table table-bordered table-sm mb-0">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th style="width: 120px;">@Get_Language_Data_Field("Mã SP")</th>
                                <th style="width: 250px;">@Get_Language_Data_Field("Tên sản phẩm")</th>
                                <th style="width: 120px;">@Get_Language_Data_Field("Số lượng")</th>
                                <th style="width: 150px;">@Get_Language_Data_Field("Đơn giá")</th>
                                <th style="width: 150px;">@Get_Language_Data_Field("Trị giá")</th>
                                <th style="width: 150px;">@Get_Language_Data_Field("Thao tác")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (v_arrDetail.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted">
                                        @Get_Language_Data_Field("Chưa có dòng chi tiết nào.")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < v_arrDetail.Count; i++)
                                {
                                    var v_objItem = v_arrDetail[i];
                                    var v_iIndex = i;

                                    <tr>
                                        <td class="text-center">@(v_iIndex + 1)</td>
                                        <td>@v_objItem.Ma_San_Pham</td>
                                        <td>@v_objItem.Ten_San_Pham</td>
                                        <td class="text-end">@v_objItem.SL_Nhap.ToString("N2")</td>
                                        <td class="text-end">@v_objItem.Don_Gia_Nhap.ToString("N0")</td>
                                        <td class="text-end">@v_objItem.Tri_Gia.ToString("N0")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-primary me-1"
                                                    @onclick="@(() => Mo_Form_Sua(v_iIndex))">
                                                <i class="mdi mdi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    @onclick="@(() => Xoa_Dong(v_iIndex))">
                                                <i class="mdi mdi-delete"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        @if (v_arrDetail.Count > 0)
                        {
                            <tfoot class="table-secondary">
                                <tr>
                                    <td colspan="5" class="text-end"><strong>@Get_Language_Data_Field("Tổng cộng"):</strong></td>
                                    <td class="text-end"><strong>@v_arrDetail.Sum(x => x.Tri_Gia).ToString("N0")</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="@(() => Modal_Cancel())">
                    @Get_Language_Data_Field("Đóng")
                </button>
            </div>
        </div>
    </div>
</div>

@* ===== SUB-MODAL: FORM THÊM/SỬA DÒNG DETAIL ===== *@
@if (r_bIs_Show_Detail_Form == true)
{
    <div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; padding-left: 0px; background-color: rgba(0, 0, 0, .5); z-index: 1060;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    @if (r_bIs_Edit_Mode == true)
                    {
                        <h5 class="modal-title">@Get_Language_Data_Field("Sửa dòng chi tiết")</h5>
                    }
                    else
                    {
                        <h5 class="modal-title">@Get_Language_Data_Field("Thêm dòng chi tiết")</h5>
                    }
                    <button type="button" class="btn-close" @onclick="@(() => r_bIs_Show_Detail_Form = false)">
                    </button>
                </div>

                @((MarkupString)r_strError_Detail)

                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12 mb-3">
                            <label class="form-label">@Get_Language_Data_Field("Sản phẩm"): <span style="color:red;">*</span></label>
                            @if (r_bIs_Edit_Mode == true)
                            {
                                @* Sửa: không cho đổi sản phẩm — hiển thị label *@
                                <input type="text" class="form-control"
                                       value="@m_objDetail.Ten_San_Pham" disabled />
                            }
                            else
                            {
                                @* Thêm: cho chọn sản phẩm *@
                                <TelerikComboBox Data="@v_arrSan_Pham"
                                                 @bind-Value="@m_objDetail.San_Pham_ID"
                                                 TextField="Ten_San_Pham"
                                                 ValueField="Auto_ID"
                                                 Placeholder="Chọn sản phẩm..."
                                                 Width="100%">
                                </TelerikComboBox>
                            }
                        </div>

                        <div class="col-lg-6 mb-3">
                            <label class="form-label">@Get_Language_Data_Field("Số lượng"): <span style="color:red;">*</span></label>
                            <TelerikNumericTextBox @bind-Value="@m_objDetail.SL_Nhap"
                                                   Format="N2"
                                                   Width="100%">
                            </TelerikNumericTextBox>
                        </div>

                        <div class="col-lg-6 mb-3">
                            <label class="form-label">@Get_Language_Data_Field("Đơn giá"): <span style="color:red;">*</span></label>
                            <TelerikNumericTextBox @bind-Value="@m_objDetail.Don_Gia_Nhap"
                                                   Format="N0"
                                                   Width="100%">
                            </TelerikNumericTextBox>
                        </div>

                        <div class="col-lg-12 mb-3">
                            <label class="form-label">@Get_Language_Data_Field("Trị giá"):</label>
                            <input type="text" class="form-control" disabled
                                   value="@((m_objDetail.SL_Nhap * m_objDetail.Don_Gia_Nhap).ToString("N0"))" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="Luu_Detail">
                        <i class="mdi mdi-content-save"></i> @Get_Language_Data_Field("Lưu")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CDM_Nhap_Kho m_objMaster = new();
    private List<CDM_Nhap_Kho_Raw_Data> v_arrDetail = new();
    private List<CDM_San_Pham> v_arrSan_Pham = new();

    private CDM_Nhap_Kho_Raw_Data m_objDetail = new();
    private bool r_bIs_Show_Detail_Form = false;
    private bool r_bIs_Edit_Mode = false;
    private int r_iEdit_Index = -1;
    private string r_strError_Detail = "";

    protected override void Init_Data() { }

    protected override void Load_Data()
    {
        v_arrSan_Pham = CCache_San_Pham.List_Data();

        // Load header (chỉ để hiển thị label)
        CDM_Nhap_Kho_Controller v_objCtrData = new();
        m_objMaster = v_objCtrData.FQ_107_NK_sp_sel_Get_By_ID(r_iAuto_ID);

        if (m_objMaster == null) m_objMaster = new CDM_Nhap_Kho();

        // Load danh sách detail
        Load_Chi_Tiet();
    }

    private void Load_Chi_Tiet()
    {
        CDM_Nhap_Kho_Controller v_objCtrData = new();
        v_arrDetail = v_objCtrData.FQ_107_NK_sp_sel_List_Detail_By_Nhap_Kho_ID(r_iAuto_ID);
    }

    private void Mo_Form_Them()
    {
        r_bIs_Edit_Mode = false;
        r_iEdit_Index = -1;
        m_objDetail = new CDM_Nhap_Kho_Raw_Data();
        m_objDetail.Nhap_Kho_ID = r_iAuto_ID;
        r_strError_Detail = "";
        r_bIs_Show_Detail_Form = true;
    }

    private void Mo_Form_Sua(int p_iIndex)
    {
        if (p_iIndex < 0 || p_iIndex >= v_arrDetail.Count) return;

        r_bIs_Edit_Mode = true;
        r_iEdit_Index = p_iIndex;

      
        var v_objSource = v_arrDetail[p_iIndex];
        m_objDetail = new CDM_Nhap_Kho_Raw_Data
        {
            Auto_ID = v_objSource.Auto_ID,
            Nhap_Kho_ID = v_objSource.Nhap_Kho_ID,
            San_Pham_ID = v_objSource.San_Pham_ID,
            Ma_San_Pham = v_objSource.Ma_San_Pham,
            Ten_San_Pham = v_objSource.Ten_San_Pham,
            SL_Nhap = Convert.ToDecimal(v_objSource.SL_Nhap),
            Don_Gia_Nhap = Convert.ToDecimal(v_objSource.Don_Gia_Nhap),
            Tri_Gia = Convert.ToDecimal(v_objSource.Tri_Gia)
        };

        r_strError_Detail = "";
        r_bIs_Show_Detail_Form = true;
    }

    private void Luu_Detail()
    {
        r_strError_Detail = "";
        try
        {
            // Validate
            if (r_bIs_Edit_Mode == false && m_objDetail.San_Pham_ID == 0)
                throw new Exception("Vui lòng chọn sản phẩm.");
            if (m_objDetail.SL_Nhap <= 0)
                throw new Exception("Số lượng nhập phải lớn hơn 0.");
            if (m_objDetail.Don_Gia_Nhap < 0)
                throw new Exception("Đơn giá nhập phải >= 0.");

            m_objDetail.Last_Updated_By = r_strActive_User_Name;
            m_objDetail.Last_Updated_By_Function = r_strActive_Function_Code;

            CDM_Nhap_Kho_Controller v_objCtrData = new();

            if (r_bIs_Edit_Mode == true)
            {
                // SỬA
                v_objCtrData.FQ_107_NK_sp_upd_Update_Detail(m_objDetail,
                    r_strActive_User_Name, r_strActive_Function_Code);
            }
            else
            {
                // THÊM MỚI
                m_objDetail.Auto_ID = v_objCtrData.FQ_107_NK_sp_ins_Insert_Detail_By_Master_ID(m_objDetail);
            }

            // Reload danh sách detail
            Load_Chi_Tiet();

            // Đóng form
            r_bIs_Show_Detail_Form = false;
        }
        catch (Exception ex)
        {
            r_strError_Detail = ex.Message;
        }
    }

    private async Task Xoa_Dong(int p_iIndex)
    {
        if (p_iIndex < 0 || p_iIndex >= v_arrDetail.Count) return;

        var v_objItem = v_arrDetail[p_iIndex];

        CDM_Nhap_Kho_Controller v_objCtrData = new();
        v_objCtrData.FQ_107_NK_sp_del_Delete_Detail_By_ID(
            v_objItem.Auto_ID,
            r_strActive_User_Name,
            r_strActive_Function_Code);

        Load_Chi_Tiet();
    }
}