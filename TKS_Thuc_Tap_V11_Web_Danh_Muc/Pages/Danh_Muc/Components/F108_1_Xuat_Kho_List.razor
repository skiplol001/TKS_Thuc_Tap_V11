@inherits FBase;

@Layout_Default_Filter(grdData, "Xuat_Kho_Template.xlsx")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@v_arrData" Height="calc(100vh - 170px)" Resizable="true" Reorderable="true" @ref="@grdData">
            <GridExport>
                <GridExcelExport FileName="Xuat_Kho_Export" AllPages="true" />
                <GridCsvExport FileName="Xuat_Kho_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px"></GridCheckboxColumn>
                <GridColumn Width="60px">
                    <Template>
                        <button class="btn btn-link" @onclick="@(()=> Open_Info((context as CDM_Xuat_Kho).Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        &nbsp;
                        <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @if (r_objChuc_Nang.Is_Have_Export_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => In_Phieu_Xuat((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-printer-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("In phiếu xuất")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Edit((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-edit-2-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Hiệu chỉnh thông tin")
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Mo_Form_Sua_Chi_Tiet((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-list-check align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Hiệu chỉnh chi tiết")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Delete_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Delete_Data((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-delete-bin-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Xóa")
                                    </button>
                                </li>
                            }
                        </ul>
                    </Template>
                </GridColumn>
                <GridColumn Field="So_Phieu_Xuat_Kho" Title="Số phiếu xuất" Width="150px"></GridColumn>
                <GridColumn Field="Ten_Kho" Title="Kho" Width="250px"></GridColumn>
                <GridColumn Field="Ngay_Xuat_Kho" Title="Ngày xuất" Width="120px">
                    <Template>
                        @((context as CDM_Xuat_Kho).Ngay_Xuat_Kho?.ToString("dd/MM/yyyy"))
                    </Template>
                </GridColumn>
                <GridColumn Field="Ghi_Chu" Title="Ghi chú" Width="300px"></GridColumn>
                <GridColumn Field="" Title=""></GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info == true)
{
    <F108_2_Xuat_Kho_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info"></F108_2_Xuat_Kho_Info>
}

@if (r_bIs_Show_Edit == true)
{
    <F108_3_Xuat_Kho_Edit r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Edit_And_Reload"></F108_3_Xuat_Kho_Edit>
}
@if (r_bIs_Show_Edit_Detail == true)
{
    <F108_4_Xuat_Kho_Edit_Detail r_iAuto_ID="@r_iEdit_Detail_ID" OnClose="@Close_Edit_Detail"></F108_4_Xuat_Kho_Edit_Detail>
}
@code {
    public List<CDM_Xuat_Kho> v_arrData = new();
    TelerikGrid<CDM_Xuat_Kho> grdData = new();

    protected override void Init_Data() { }
    private bool r_bIs_Show_Edit_Detail = false;
    private long r_iEdit_Detail_ID = 0;
    protected override void Load_Data()
    {
        Format_Grid(grdData);
        CDM_Xuat_Kho_Controller v_objCtrData = new();
        v_arrData = v_objCtrData.FQ_108_XK_sp_sel_List_By_Created(r_objFilter.Date_From, r_objFilter.Date_To);
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        CDM_Xuat_Kho_Controller v_objCtrData = new();
        CDM_Xuat_Kho v_objData = v_objCtrData.FQ_108_XK_sp_sel_Get_By_ID(p_iAuto_ID);
        if (v_objData != null)
            r_strDelete_Key = v_objData.So_Phieu_Xuat_Kho;

        v_objCtrData.FQ_108_XK_sp_del_Delete_By_ID(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
        CCache_Xuat_Kho.Delete_Data(p_iAuto_ID);
    }
    private async Task Close_Edit_And_Reload(CEvent_Call_Back p_objEvent)
    {
        // Đóng modal
        r_bIs_Show_Edit = false;

        // Đợi 1 nhịp để Blazor render modal đóng
        await Task.Delay(100);

        // Reload lại grid
        Load_Data();

        // Báo Blazor cập nhật UI
        StateHasChanged();
    }
    private void Mo_Form_Sua_Chi_Tiet(long p_iAuto_ID)
    {
        r_iEdit_Detail_ID = p_iAuto_ID;
        r_bIs_Show_Edit_Detail = true;
    }

    private async Task Close_Edit_Detail(CEvent_Call_Back p_objEvent)
    {
        r_bIs_Show_Edit_Detail = false;
        await Task.Delay(100);
        Load_Data();
        StateHasChanged();
    }
    [Inject] private NavigationManager NavManager { get; set; }

    private void In_Phieu_Xuat(long p_iAuto_ID)
    {
        try
        {
            r_strError = "";

            // Gọi API endpoint — trình duyệt tự tải file
            string v_strURL = NavManager.BaseUri + "api/download/phieu-xuat/" + p_iAuto_ID;
            NavManager.NavigateTo(v_strURL, forceLoad: true);
        }
        catch (Exception ex)
        {
            r_strError = ex.Message;
        }
    }
}