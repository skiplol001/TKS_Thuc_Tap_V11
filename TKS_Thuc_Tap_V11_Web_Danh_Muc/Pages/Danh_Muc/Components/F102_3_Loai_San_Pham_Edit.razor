@inherits FBase;

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; padding-left: 0px; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                @if (r_iAuto_ID != 0)
                {
                    <h5 class="modal-title">@Get_Language_Data_Field("Hiệu chỉnh")</h5>
                }
                else
                {
                    <h5 class="modal-title">@Get_Language_Data_Field("Thêm mới")</h5>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="@(() => Modal_Cancel())">
                </button>
            </div>

            @((MarkupString)r_strError)

            <EditForm Model="@m_objData">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row mb-3">
                                <div class="col-lg-11">
                                    <label class="form-label">@Get_Language_Data_Field("Mã loại sản phẩm"): <span style="color:red;">*</span></label>
                                    <input @ref="txtFocus" @bind="@m_objData.Ma_LSP" class="form-control">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-11">
                                    <label class="form-label">@Get_Language_Data_Field("Tên loại sản phẩm"): <span style="color:red;">*</span></label>
                                    <input @bind="@m_objData.Ten_LSP" class="form-control">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-lg-11">
                                    <label class="form-label">@Get_Language_Data_Field("Ghi chú"):</label>
                                    <input @bind="@m_objData.Ghi_Chu" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="@Save_Data" style="margin-right: 37px;">
                    @Get_Language_Data_Field("Lưu Thay Đổi")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private CDM_Loai_San_Pham m_objData = new();

    protected override void Init_Data() { }

    protected override void Load_Data()
    {
        CDM_Loai_San_Pham_Controller v_objCtrData = new();
        m_objData = v_objCtrData.FQ_102_LSP_sp_sel_Get_By_ID(r_iAuto_ID);

        if (m_objData == null)
            m_objData = new CDM_Loai_San_Pham();
        else
        {
            r_bUpdate = true;
            CDM_Loai_San_Pham v_objClone = new();
            CUtility.Clone_Entity(m_objData, v_objClone);
            r_objSource = v_objClone;
        }
    }

    protected override void Add_Data()
    {
        CDM_Loai_San_Pham_Controller v_objCtrData = new();
        Check_Data();

        m_objData.Last_Updated_By = r_strActive_User_Name;
        m_objData.Last_Updated_By_Function = r_strActive_Function_Code;
        m_objData.Auto_ID = r_iAuto_ID = v_objCtrData.FQ_102_LSP_sp_ins_Insert(m_objData);

        r_strAdd_Key = m_objData.Ma_LSP;
        CCache_Loai_San_Pham.Add_Data(m_objData);
    }

    protected override void Update_Data()
    {
        CDM_Loai_San_Pham_Controller v_objCtrData = new();
        Check_Data();

        m_objData.Last_Updated_By = r_strActive_User_Name;
        m_objData.Last_Updated_By_Function = r_strActive_Function_Code;
        v_objCtrData.FQ_102_LSP_sp_upd_Update(m_objData);

        CDM_Loai_San_Pham v_objClone = new();
        CUtility.Clone_Entity(m_objData, v_objClone);
        r_objDes = v_objClone;

        CCache_Loai_San_Pham.Update_Data(m_objData);
    }

    private void Check_Data()
    {
        r_strError = "";
        try
        {
            if (string.IsNullOrEmpty(m_objData.Ma_LSP.Trim()))
                throw new Exception("Mã loại sản phẩm không được để trống.");

            if (string.IsNullOrEmpty(m_objData.Ten_LSP.Trim()))
                throw new Exception("Tên loại sản phẩm không được để trống.");

            CDM_Loai_San_Pham v_objCheck_Ma = CCache_Loai_San_Pham.Get_Data_By_Ma_LSP(m_objData.Ma_LSP);
            if (v_objCheck_Ma != null && v_objCheck_Ma.Auto_ID != m_objData.Auto_ID)
                throw new Exception("Mã loại sản phẩm đã tồn tại.");

            CDM_Loai_San_Pham v_objCheck_Ten = CCache_Loai_San_Pham.Get_Data_By_Ten_LSP(m_objData.Ten_LSP);
            if (v_objCheck_Ten != null && v_objCheck_Ten.Auto_ID != m_objData.Auto_ID)
                throw new Exception("Tên loại sản phẩm đã tồn tại.");
        }
        catch (Exception ex) { throw new Exception(ex.Message); }
    }
}