@inherits FBase;

@Layout_Default_Filter(grdData, "NCC_Template.xlsx")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@v_arrData" Height="calc(100vh - 170px)" Resizable="true" Reorderable="true" @ref="@grdData">
            <GridExport>
                <GridExcelExport FileName="NCC_Export" AllPages="true" />
                <GridCsvExport FileName="NCC_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px"></GridCheckboxColumn>
                <GridColumn Width="60px">
                    <Template>
                        <button class="btn btn-link" @onclick="@(()=> Open_Info((context as CDM_NCC).Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        &nbsp;
                        <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(()=> Open_Edit((context as CDM_NCC).Auto_ID))">
                                        <i class="ri-edit-2-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Hiệu chỉnh")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Delete_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(()=> Delete_Data((context as CDM_NCC).Auto_ID))">
                                        <i class="ri-delete-bin-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Xóa")
                                    </button>
                                </li>
                            }
                        </ul>
                    </Template>
                </GridColumn>
                <GridColumn Field="Ma_NCC" Title="Mã NCC" Width="150px"></GridColumn>
                <GridColumn Field="Ten_NCC" Title="Tên nhà cung cấp" Width="400px"></GridColumn>
                <GridColumn Field="Ghi_Chu" Title="Ghi chú" Width="300px"></GridColumn>
                <GridColumn Field="" Title=""></GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info == true)
{
    <F104_2_NCC_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info"></F104_2_NCC_Info>
}

@if (r_bIs_Show_Help_Guide == true)
{
    <FCommon_Help_Guide m_strFCode="@r_strActive_Function_Code" OnClose="@Close_Helpguide"></FCommon_Help_Guide>
}

@if (r_bIs_Show_Edit == true)
{
    <F104_3_NCC_Edit r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Edit"></F104_3_NCC_Edit>
}

@if (r_bIs_Show_Message_Info == true)
{
    <FCommon_Message_Info r_strMessage_Header="@r_strMessage_Header" r_strMessage_Info="@r_strMessage_Info" OnClose="@Close_Message_Info"></FCommon_Message_Info>
}

@code {
    public List<CDM_NCC> v_arrData = new();
    TelerikGrid<CDM_NCC> grdData = new();

    protected override void Init_Data() { }

    protected override void Load_Data()
    {
        Format_Grid(grdData);
        CDM_NCC_Controller v_objCtrData = new();
        v_arrData = v_objCtrData.FQ_104_NCC_sp_sel_List_By_Created(r_objFilter.Date_From, r_objFilter.Date_To);
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        CDM_NCC_Controller v_objCtrData = new();
        CDM_NCC v_objData = v_objCtrData.FQ_104_NCC_sp_sel_Get_By_ID(p_iAuto_ID);
        if (v_objData != null)
            r_strDelete_Key = v_objData.Ma_NCC;

        v_objCtrData.FQ_104_NCC_sp_del_Delete_By_ID(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
        CCache_NCC.Delete_Data(p_iAuto_ID);
    }
}