@inherits FBase;

@Layout_Default_Filter(grdData, "Nhap_Kho_Template.xlsx")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@v_arrData" Height="calc(100vh - 170px)" Resizable="true" Reorderable="true" @ref="@grdData">
            <GridExport>
                <GridExcelExport FileName="Nhap_Kho_Export" AllPages="true" />
                <GridCsvExport FileName="Nhap_Kho_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px"></GridCheckboxColumn>
                <GridColumn Width="60px">
                    <Template>
                        <button class="btn btn-link" @onclick="@(() => Open_Info((context as CDM_Nhap_Kho).Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        &nbsp;
                        <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @if (r_objChuc_Nang.Is_Have_Export_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => In_Phieu_Nhap((context as CDM_Nhap_Kho).Auto_ID))">
                                        <i class="ri-printer-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("In phiếu nhập")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Edit((context as CDM_Nhap_Kho).Auto_ID))">
                                        <i class="ri-edit-2-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Hiệu chỉnh thông tin")
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Mo_Form_Sua_Chi_Tiet((context as CDM_Nhap_Kho).Auto_ID))">
                                        <i class="ri-list-check align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Hiệu chỉnh chi tiết")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Delete_Permission == true)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Delete_Data((context as CDM_Nhap_Kho).Auto_ID))">
                                        <i class="ri-delete-bin-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Xóa")
                                    </button>
                                </li>
                            }
                        </ul>
                    </Template>
                </GridColumn>
                <GridColumn Field="So_Phieu_Nhap_Kho" Title="Số phiếu nhập" Width="150px"></GridColumn>
                <GridColumn Field="Ten_Kho" Title="Kho" Width="250px"></GridColumn>
                <GridColumn Field="Ngay_Nhap_Kho" Title="Ngày nhập" Width="120px">
                    <Template>
                        @((context as CDM_Nhap_Kho).Ngay_Nhap_Kho?.ToString("dd/MM/yyyy"))
                    </Template>
                </GridColumn>
                <GridColumn Field="Ghi_Chu" Title="Ghi chú" Width="300px"></GridColumn>
                <GridColumn Field="" Title=""></GridColumn>
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info == true)
{
    <F107_2_Nhap_Kho_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info"></F107_2_Nhap_Kho_Info>
}

@if (r_bIs_Show_Edit == true)
{
    <F107_3_Nhap_Kho_Edit r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Edit"></F107_3_Nhap_Kho_Edit>
}

@if (r_bIs_Show_Message_Info == true)
{
    <FCommon_Message_Info r_strMessage_Header="@r_strMessage_Header" r_strMessage_Info="@r_strMessage_Info" OnClose="@Close_Message_Info"></FCommon_Message_Info>
}
@if (r_bIs_Show_Edit_Detail == true)
{
    <F107_4_Nhap_Kho_Edit_Detail r_iAuto_ID="@r_iEdit_Detail_ID" OnClose="@Close_Edit_Detail"></F107_4_Nhap_Kho_Edit_Detail>
}
@code {
    public List<CDM_Nhap_Kho> v_arrData = new();
    TelerikGrid<CDM_Nhap_Kho> grdData = new();

    protected override void Init_Data() { }
    private bool r_bIs_Show_Edit_Detail = false;
    private long r_iEdit_Detail_ID = 0;

    protected override void Load_Data()
    {
        Format_Grid(grdData);
        CDM_Nhap_Kho_Controller v_objCtrData = new();
        v_arrData = v_objCtrData.FQ_107_NK_sp_sel_List_By_Created(r_objFilter.Date_From, r_objFilter.Date_To);
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        CDM_Nhap_Kho_Controller v_objCtrData = new();
        CDM_Nhap_Kho v_objData = v_objCtrData.FQ_107_NK_sp_sel_Get_By_ID(p_iAuto_ID);
        if (v_objData != null)
            r_strDelete_Key = v_objData.So_Phieu_Nhap_Kho;

        v_objCtrData.FQ_107_NK_sp_del_Delete_By_ID(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
        CCache_Nhap_Kho.Delete_Data(p_iAuto_ID);
    }
    private void Mo_Form_Sua_Chi_Tiet(long p_iAuto_ID)
    {
        r_iEdit_Detail_ID = p_iAuto_ID;
        r_bIs_Show_Edit_Detail = true;
    }

    private void Close_Edit_Detail()
    {
        r_bIs_Show_Edit_Detail = false;
        Load_Data();  // Reload grid để update tổng tiền (nếu có hiển thị)
    }
    [Inject] private IJSRuntime JSRuntime { get; set; }

    [Inject] private NavigationManager NavManager { get; set; }

    private void In_Phieu_Nhap(long p_iAuto_ID)
    {
        try
        {
            r_strError = "";

            // Chuyển sang endpoint API để tải file
            // Trình duyệt sẽ tự tải file từ URL này
            string v_strURL = NavManager.BaseUri + "api/download/phieu-nhap/" + p_iAuto_ID;

            // Mở URL trong tab mới hoặc tải trực tiếp
            NavManager.NavigateTo(v_strURL, forceLoad: true);
        }
        catch (Exception ex)
        {
            r_strError = ex.Message;
        }
    }
}